---
// Sección de Precios (#precios). Ver docs/WEB_STYLE_GUIDE.md §8.4 y §10
import SectionHeading from "../ui/SectionHeading.astro";
import PriceCard from "../ui/PriceCard.astro";
import Button from "../ui/Button.astro";
import { site } from "../../data/site";

const { pricing } = site;
---

<section
  id="precios"
  class="relative border-y border-cv-border bg-cv-surface py-16 sm:py-24"
  aria-labelledby="precios-title"
>
  <div class="mx-auto max-w-[1280px] px-5 sm:px-12">
    <!-- Encabezado de la sección -->
    <SectionHeading
      id="precios-title"
      eyebrow={pricing.eyebrow}
      title={pricing.title}
      subtitle={pricing.subtitle}
    />

    <!-- Cuadrícula de 3 tarjetas de precios -->
    <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        pricing.plans.map((plan) => (
          <PriceCard
            title={plan.title}
            price={plan.price}
            priceNote={"priceNote" in plan ? plan.priceNote : undefined}
            description={plan.description}
            includes={plan.includes}
            featured={plan.featured}
            badge={"badge" in plan ? plan.badge : undefined}
            ctaLabel={plan.ctaLabel}
            href={plan.href}
          />
        ))
      }
    </div>

    <!-- Aclaración obligatoria debajo de los precios (WEB_STYLE_GUIDE.md §8.4) -->
    <p class="mt-6 text-center text-sm text-cv-muted">
      * {pricing.disclaimer}
    </p>

    <!-- Bloque especial para Pymes con borde punteado en acento al 50% -->
    <div
      class="mt-12 flex flex-col items-start justify-between gap-6 rounded-cv-xl border-2 border-dashed border-cv-accent/50 bg-cv-surface-2/70 p-8 sm:p-10 lg:flex-row lg:items-center"
    >
      <div class="max-w-[760px]">
        <span class="inline-flex rounded-cv-pill border border-cv-accent/40 bg-cv-accent/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cv-accent">
          {pricing.sme.tag}
        </span>
        <h3 class="mt-3 font-display text-2xl font-bold leading-snug text-cv-text">
          {pricing.sme.title}
        </h3>
        <p class="mt-2 text-[15px] leading-relaxed text-cv-muted">
          {pricing.sme.description}
        </p>
        <p class="mt-3 text-xs font-semibold text-cv-accent/90">
          {pricing.sme.statusNote}
        </p>
      </div>

      <div class="shrink-0 w-full lg:w-auto">
        <Button
          variant="outline-accent"
          size="lg"
          href={pricing.sme.href}
          class="w-full justify-center transition-colors hover:bg-cv-accent hover:text-cv-on-accent"
        >
          {pricing.sme.ctaLabel}
        </Button>
      </div>
    </div>
  </div>
</section>
