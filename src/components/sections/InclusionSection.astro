---
// Sección de Atención Inclusiva en LSCh (#lsch). Ver docs/BRAND.md §8 y docs/WEB_STYLE_GUIDE.md §10
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import { site } from "../../data/site";

const { inclusion } = site;
---

<section
  id="lsch"
  class="relative py-16 sm:py-24"
  aria-labelledby="lsch-title"
>
  <div class="mx-auto max-w-[1280px] px-5 sm:px-12">
    <!-- Encabezado de la sección -->
    <SectionHeading
      id="lsch-title"
      eyebrow={inclusion.eyebrow}
      title={inclusion.title}
      subtitle={inclusion.subtitle}
    />

    <!-- Panel principal destacado -->
    <div
      class="mt-12 rounded-cv-xl border border-cv-accent/30 bg-gradient-to-br from-cv-surface-2 via-cv-surface to-cv-bg p-8 sm:p-12 shadow-[0_0_40px_-15px_var(--cv-glow)]"
    >
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <!-- Columna de información y pilares (7 cols) -->
        <div class="flex flex-col items-start gap-8 lg:col-span-7">
          <div class="space-y-6">
            {
              inclusion.pillars.map((pillar) => (
                <div class="flex items-start gap-4">
                  <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-cv-sm border border-cv-accent/30 bg-cv-accent/15 text-cv-accent">
                    <svg
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2.5"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-display text-lg font-bold text-cv-text">
                      {pillar.title}
                    </h3>
                    <p class="mt-1.5 text-[15px] leading-relaxed text-cv-muted">
                      {pillar.text}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="pt-2">
            <Button size="lg" href={inclusion.href}>
              {inclusion.ctaLabel}
            </Button>
          </div>
        </div>

        <!-- Columna de tarjeta visual explicativa (5 cols) -->
        <div class="lg:col-span-5">
          <div class="rounded-cv-lg border border-cv-border bg-cv-bg/80 p-7 sm:p-8 backdrop-blur-sm shadow-xl">
            <div class="flex items-center justify-between gap-3">
              <span class="inline-flex rounded-cv-pill border border-cv-accent/40 bg-cv-accent/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cv-accent">
                {inclusion.card.tag}
              </span>

              <!-- Icono ilustrativo de video/comunicación visual -->
              <span class="flex h-10 w-10 items-center justify-center rounded-cv-sm border border-cv-accent/30 bg-cv-surface text-cv-accent">
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m22 8-6 4 6 4V8Z" />
                  <rect width="14" height="12" x="2" y="6" rx="2" />
                </svg>
              </span>
            </div>

            <h3 class="mt-5 font-display text-xl font-bold text-cv-text">
              {inclusion.card.heading}
            </h3>

            <ol class="mt-5 space-y-4 text-sm text-cv-muted">
              {
                inclusion.card.steps.map((step, index) => (
                  <li class="flex items-start gap-3">
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-cv-pill bg-cv-accent text-xs font-bold text-cv-on-accent">
                      {index + 1}
                    </span>
                    <span class="leading-relaxed">{step}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
