---
// Encabezado de sección reutilizable. Ver docs/WEB_STYLE_GUIDE.md §8.6
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  id?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  id,
  align = "left",
  class: className,
} = Astro.props;

const isCenter = align === "center";
---

<div
  class:list={[
    "flex flex-col gap-3",
    isCenter ? "items-center text-center mx-auto" : "items-start text-left",
    className,
  ]}
>
  {
    eyebrow && (
      <span class="text-sm font-semibold uppercase tracking-[0.08em] text-cv-accent">
        {eyebrow}
      </span>
    )
  }

  <h2
    id={id}
    class="font-display text-[clamp(30px,3.6vw,48px)] font-bold leading-[1.1] text-cv-text"
  >
    {title}
  </h2>

  {
    subtitle && (
      <p class="max-w-[600px] text-[18px] leading-relaxed text-cv-muted">
        {subtitle}
      </p>
    )
  }
</div>
