---
// Pie de página. Ver docs/WEB_STYLE_GUIDE.md §8.9 y docs/BRAND.md §5.4
import { site } from "../../data/site";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-cv-border bg-cv-bg text-cv-muted">
  <div class="mx-auto max-w-[1280px] px-5 py-12 sm:px-12 lg:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
      <!-- Columna 1: Marca y Tagline (6 cols) -->
      <div class="flex flex-col items-start gap-4 md:col-span-6">
        <a
          href="#contenido"
          class="group flex items-center gap-2.5 rounded-cv-sm focus-visible:outline-2 focus-visible:outline-cv-accent"
          aria-label={`${site.name} — Ir arriba`}
        >
          <span
            class="flex h-8 w-8 items-center justify-center rounded-cv-sm border border-cv-accent/30 bg-cv-surface-2 text-cv-accent"
          >
            <!-- Icono Laptop con Check -->
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="12" rx="2"></rect>
              <path d="M2 20h20"></path>
              <path d="m9 10 2 2 4-4" class="stroke-cv-accent" stroke-width="2.5"></path>
            </svg>
          </span>
          <span class="font-display text-xl font-bold tracking-tight text-cv-text">
            Compu<span class="text-cv-accent">Vecino</span>
          </span>
        </a>

        <p class="max-w-[40ch] text-sm text-cv-muted">
          {site.footer.tagline}
        </p>

        <p class="text-xs text-cv-muted/80">
          {site.footer.location}
        </p>
      </div>

      <!-- Columna 2: Enlaces rápidos (3 cols) -->
      <div class="flex flex-col gap-3 md:col-span-3">
        <h4 class="font-display text-sm font-semibold uppercase tracking-wider text-cv-text">
          Navegación
        </h4>
        <ul class="flex flex-col space-y-2 text-sm">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="transition-colors hover:text-cv-accent focus-visible:text-cv-accent focus-visible:outline-none"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Contacto y Atención (3 cols) -->
      <div class="flex flex-col gap-3 md:col-span-3">
        <h4 class="font-display text-sm font-semibold uppercase tracking-wider text-cv-text">
          Contacto
        </h4>
        <p class="text-sm">
          <a
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="text-cv-accent transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-cv-accent"
          >
            {site.phone}
          </a>
        </p>
        <p class="text-xs text-cv-muted/80 leading-relaxed">
          Atención por WhatsApp mediante texto, audio o video en Lengua de Señas Chilena.
        </p>
      </div>
    </div>

    <!-- Barra inferior con copyright y nota de accesibilidad -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-cv-border pt-8 text-xs text-cv-muted/70 sm:flex-row"
    >
      <p>
        © {currentYear} {site.name}. Todos los derechos reservados.
      </p>
      <p class="text-center sm:text-right">
        {site.footer.accessibilityNote}
      </p>
    </div>
  </div>
</footer>
