---
// Navbar fija, accesible y translúcida. Ver docs/WEB_STYLE_GUIDE.md §8.7 y docs/BRAND.md §6.1
import Button from "./Button.astro";
import { site } from "../../data/site";
---

<header
  class="fixed top-0 left-0 right-0 z-40 border-b border-cv-border bg-cv-bg/85 backdrop-blur-md transition-colors duration-(--cv-dur-fast)"
>
  <div class="mx-auto flex h-18 max-w-[1280px] items-center justify-between px-5 sm:px-12">
    <!-- Logo provisorio según BRAND.md §6.1: icono laptop con check + texto CompuVecino -->
    <a
      href="#contenido"
      class="group flex items-center gap-2.5 rounded-cv-sm py-1.5 focus-visible:outline-2 focus-visible:outline-cv-accent"
      aria-label={`${site.name} — Inicio`}
    >
      <span
        class="flex h-9 w-9 items-center justify-center rounded-cv-sm border border-cv-accent/30 bg-cv-surface-2 text-cv-accent shadow-[0_0_15px_-4px_var(--cv-glow)] transition-transform duration-(--cv-dur-fast) group-hover:scale-105"
      >
        <!-- Icono Laptop con Check -->
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="12" rx="2"></rect>
          <path d="M2 20h20"></path>
          <path d="m9 10 2 2 4-4" class="stroke-cv-accent" stroke-width="2.5"></path>
        </svg>
      </span>
      <span class="font-display text-xl font-bold tracking-tight text-cv-text">
        Compu<span class="text-cv-accent">Vecino</span>
      </span>
    </a>

    <!-- Navegación de Escritorio -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      <ul class="flex items-center gap-6 lg:gap-8 text-sm font-medium text-cv-muted">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="transition-colors duration-(--cv-dur-fast) ease-(--cv-ease) hover:text-cv-accent focus-visible:text-cv-accent focus-visible:outline-none"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button size="md" href={site.navCta.href}>
        {site.navCta.label}
      </Button>
    </nav>

    <!-- Botón Hamburguesa Móvil (Objetivo táctil mín. 44x44px) -->
    <button
      type="button"
      id="cv-nav-toggle"
      class="flex h-11 w-11 items-center justify-center rounded-cv-pill border border-cv-border text-cv-text hover:text-cv-accent focus-visible:outline-2 focus-visible:outline-cv-accent md:hidden"
      aria-expanded="false"
      aria-controls="cv-mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <!-- Icono Menú -->
      <svg
        id="cv-icon-open"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- Icono Cerrar -->
      <svg
        id="cv-icon-close"
        class="hidden h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div
    id="cv-mobile-menu"
    class="hidden border-t border-cv-border bg-cv-bg/95 px-6 pt-4 pb-8 backdrop-blur-xl md:hidden"
    aria-label="Menú móvil"
  >
    <nav class="flex flex-col gap-4">
      <ul class="flex flex-col divide-y divide-cv-border">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="cv-mobile-link flex min-h-11 items-center py-2.5 text-base font-medium text-cv-text transition-colors hover:text-cv-accent focus-visible:text-cv-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="pt-2">
        <Button size="lg" href={site.navCta.href} class="w-full justify-center">
          {site.navCta.label}
        </Button>
      </div>
    </nav>
  </div>
</header>

<script>
  function initNavbar() {
    const toggleBtn = document.getElementById("cv-nav-toggle");
    const mobileMenu = document.getElementById("cv-mobile-menu");
    const iconOpen = document.getElementById("cv-icon-open");
    const iconClose = document.getElementById("cv-icon-close");
    const mobileLinks = document.querySelectorAll(".cv-mobile-link");

    if (!toggleBtn || !mobileMenu || !iconOpen || !iconClose) return;

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      toggleBtn?.setAttribute("aria-expanded", "true");
      toggleBtn?.setAttribute("aria-label", "Cerrar menú de navegación");
      mobileMenu?.classList.remove("hidden");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    }

    function closeMenu(focusToggle = false) {
      if (!isOpen) return;
      isOpen = false;
      toggleBtn?.setAttribute("aria-expanded", "false");
      toggleBtn?.setAttribute("aria-label", "Abrir menú de navegación");
      mobileMenu?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      if (focusToggle) {
        toggleBtn?.focus();
      }
    }

    toggleBtn.addEventListener("click", () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Cierre al presionar cualquier enlace ancla
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => closeMenu());
    });

    // Cierre al presionar Escape y devolver foco al botón
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeMenu(true);
      }
    });

    // Cierre si la ventana se amplía a tamaño escritorio
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768 && isOpen) {
        closeMenu();
      }
    });
  }

  // Inicializar al cargar el documento
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNavbar);
  } else {
    initNavbar();
  }
</script>
