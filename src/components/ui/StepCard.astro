---
// Tarjeta para los pasos del proceso. Ver docs/WEB_STYLE_GUIDE.md §8.5 y §5
interface Props {
  number: string;
  title: string;
  text: string;
  class?: string;
}

const { number, title, text, class: className } = Astro.props;
---

<article
  class:list={[
    "group relative flex flex-col rounded-cv-lg border border-cv-border bg-white/[0.04] p-7 sm:p-8",
    "transition-all duration-(--cv-dur-base) ease-(--cv-ease)",
    "hover:border-cv-accent/55 hover:shadow-[0_30px_60px_-20px_var(--cv-glow)] motion-safe:hover:-translate-y-2",
    className,
  ]}
>
  <!-- Cuadro de 48x48 px con número, fondo acento y sombra sólida desplazada 6px 6px 0 en acento al 25% -->
  <div
    class="flex h-12 w-12 items-center justify-center rounded-cv-sm bg-cv-accent font-display text-xl font-bold text-cv-on-accent shadow-[6px_6px_0_0_rgb(74_222_128_/_0.25)] transition-transform duration-(--cv-dur-fast) group-hover:scale-105"
    aria-hidden="true"
  >
    {number}
  </div>

  <!-- Título H3 -->
  <h3 class="mt-7 font-display text-xl font-bold leading-snug text-cv-text">
    <span class="sr-only">Paso {number}: </span>
    {title}
  </h3>

  <!-- Descripción del paso -->
  <p class="mt-3 text-[15px] leading-relaxed text-cv-muted">
    {text}
  </p>
</article>
