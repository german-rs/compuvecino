---
// Tarjeta para modalidades de atención. Ver docs/WEB_STYLE_GUIDE.md §8.2 y §5
import Button from "./Button.astro";

interface Props {
  tag: string;
  title: string;
  description: string;
  features: readonly string[] | string[];
  ctaLabel: string;
  href: string;
  type?: "domicilio" | "taller" | "remoto";
  class?: string;
}

const {
  tag,
  title,
  description,
  features,
  ctaLabel,
  href,
  type = "domicilio",
  class: className,
} = Astro.props;
---

<article
  class:list={[
    "group relative flex flex-col justify-between rounded-cv-lg border border-cv-border bg-cv-surface-2 p-7 sm:p-8",
    "transition-all duration-(--cv-dur-base) ease-(--cv-ease)",
    "hover:border-cv-accent/55 hover:shadow-[0_30px_60px_-20px_var(--cv-glow)] motion-safe:hover:-translate-y-2",
    className,
  ]}
>
  <div>
    <!-- Encabezado con Icono y Tag -->
    <div class="flex items-start justify-between gap-4">
      <div
        class="flex h-12 w-12 items-center justify-center rounded-cv-md border border-cv-accent/30 bg-cv-surface text-cv-accent shadow-[0_0_15px_-4px_var(--cv-glow)]"
      >
        {
          type === "domicilio" && (
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline stroke-linecap="round" stroke-linejoin="round" points="9 22 9 12 15 12 15 22" />
            </svg>
          )
        }
        {
          type === "taller" && (
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
            </svg>
          )
        }
        {
          type === "remoto" && (
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="8" y1="21" x2="16" y2="21" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="12" y1="17" x2="12" y2="21" stroke-linecap="round" stroke-linejoin="round" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h.01M12 8h.01M17 8h.01" />
            </svg>
          )
        }
      </div>

      <span class="inline-flex rounded-cv-pill border border-cv-accent/30 bg-cv-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cv-accent">
        {tag}
      </span>
    </div>

    <!-- Título H3 -->
    <h3 class="mt-6 font-display text-2xl font-bold leading-snug text-cv-text">
      {title}
    </h3>

    <!-- Descripción -->
    <p class="mt-3 text-[15px] leading-relaxed text-cv-muted">
      {description}
    </p>

    <!-- Lista de características -->
    <ul class="mt-6 space-y-2.5 border-t border-cv-border pt-6 text-sm text-cv-text/90">
      {
        features.map((feature) => (
          <li class="flex items-start gap-2.5">
            <svg
              class="mt-1 h-4 w-4 shrink-0 text-cv-accent"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span>{feature}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Botón de acción hacia WhatsApp -->
  <div class="mt-8">
    <Button
      variant="outline-accent"
      size="md"
      href={href}
      class="w-full justify-center transition-colors hover:bg-cv-accent hover:text-cv-on-accent"
    >
      {ctaLabel}
    </Button>
  </div>
</article>
